#!/bin/bash

# 🎨 Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# 🚀 LeetCode Swift CLI Wrapper

COMMAND=$1
ARG=$2

print_banner() {
    echo -e "${BLUE}${BOLD}"
    echo "  _                _    _____          _      "
    echo " | |    ___  ___ _| |_ / ____|   _ _ _| |_    "
    echo " | |   /   \/   \ | |   | | | | | | | | | |   "
    echo " | |___|  __|  __| | |_| |__| |_| | | | | |_  "
    echo " |_____|\___|\___| \___|\_____|\__,_|_|_|\__| "
    echo -e "${NC}"
}

case "$COMMAND" in
    catalog)
        echo -e "${BLUE}➤ Updating local problem catalog...${NC}"
        python3 scripts/update_catalog.py
        ;;
    get)
        if [ -z "$ARG" ]; then
            echo -e "${RED}❌ Error: Please provide a Problem ID.${NC}"
            echo -e "${BLUE}Usage: ./leet get [ID]${NC}"
            exit 1
        fi
        echo -e "${BLUE}➤ Fetching problem ${BOLD}#$ARG${NC}${BLUE}...${NC}"
        python3 scripts/fetch_problem.py --id "$ARG"
        if [ $? -eq 0 ]; then
            echo -e "${GREEN}✔ Problem fetched successfully!${NC}"
            echo -e "${BLUE}➤ Syncing README...${NC}"
            python3 scripts/sync_readme.py
        else
            echo -e "${RED}❌ Failed to fetch problem #$ARG.${NC}"
        fi
        ;;
    sync)
        echo -e "${BLUE}➤ Syncing progress table...${NC}"
        python3 scripts/sync_readme.py
        echo -e "${GREEN}✔ README.md updated.${NC}"
        ;;
    test)
        echo -e "${BLUE}➤ Running Swift tests...${NC}"
        swift test
        ;;
    *)
        print_banner
        echo -e "${BOLD}Usage:${NC} ./leet ${BLUE}[command]${NC}"
        echo ""
        echo -e "  ${BLUE}catalog${NC}   Update local problems.json"
        echo -e "  ${BLUE}get [id]${NC}  Fetch problem, generate template & sync README"
        echo -e "  ${BLUE}sync${NC}      Update README manually"
        echo -e "  ${BLUE}test${NC}      Run all unit tests"
        echo ""
        ;;
esac
